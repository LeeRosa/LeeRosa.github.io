---
import { getCollection } from "astro:content";

const projects = [
  {
    title: "Pose Estimation AR",
    description:
      "Real-time body and hand tracking with interactive AR effects.",
    tags: ["Computer Vision", "MediaPipe", "Web"],
    year: "2026",
    emoji: "✦",
    comingSoon: false,
  },
  {
    title: "Coming Soon",
    description:
      "Something fun is probably happening.",
    tags: ["NEXT PROJECT"],
    year: "SOON",
    emoji: "⋯",
    comingSoon: true,
  },
];

const notes = (await getCollection("blog"))
  .filter((note) => !note.data.draft)
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  )
  .slice(0, 6);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Rosa Lee — AI & Computer Vision</title>

    <meta
      name="description"
      content="Portfolio, projects and engineering notes by Rosa Lee."
    />

    <style>
      :root {
        --bg: #f5f4ee;
        --text: #171714;
        --muted: #73736d;
        --line: #d9d8d1;

        --green: #dff4a5;
        --blue: #d9e8ff;
        --purple: #eadcff;

        --mac-red: #ff5f57;
        --mac-yellow: #febc2e;
        --mac-green: #28c840;

        font-family:
          Inter,
          ui-sans-serif,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        width: min(1180px, calc(100% - 48px));
        margin: 0 auto;
      }

      /* -------------------------
         NAV
      -------------------------- */

      header {
        height: 90px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        font-size: 16px;
        font-weight: 750;
        letter-spacing: -0.03em;
      }

      nav {
        display: flex;
        gap: 32px;
        font-size: 14px;
      }

      nav a {
        color: var(--muted);
        transition: 0.2s;
      }

      nav a:hover {
        color: var(--text);
      }

      /* -------------------------
         HERO
      -------------------------- */

      .hero {
        min-height: 690px;
        display: grid;
        grid-template-columns: 1fr 0.9fr;
        align-items: center;
        gap: 70px;
      }

      .eyebrow {
        font-size: 12px;
        letter-spacing: 0.15em;
        color: var(--muted);
        margin-bottom: 22px;
      }

      h1 {
        font-size: clamp(60px, 7vw, 104px);
        letter-spacing: -0.065em;
        line-height: 0.9;
        margin: 0;
        font-weight: 720;
      }

      .hero-copy {
        max-width: 520px;
        margin-top: 34px;
        color: var(--muted);
        font-size: 17px;
        line-height: 1.7;
      }

      /* -------------------------
         MAC WINDOW
      -------------------------- */

      .window {
        background: #fcfcfa;
        border: 1px solid #d5d4ce;
        border-radius: 18px;
        overflow: hidden;

        box-shadow:
          0 30px 60px rgba(0, 0, 0, 0.08),
          0 4px 15px rgba(0, 0, 0, 0.04);

        transform: rotate(1.5deg);
        transition: 0.35s ease;
      }

      .window:hover {
        transform: rotate(0deg) translateY(-6px);
      }

      .window-bar {
        height: 48px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0 18px;
        border-bottom: 1px solid #e6e5df;
      }

      .dots {
        display: flex;
        gap: 7px;
      }

      .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
      }

      .dot:nth-child(1) {
        background: var(--mac-red);
      }

      .dot:nth-child(2) {
        background: var(--mac-yellow);
      }

      .dot:nth-child(3) {
        background: var(--mac-green);
      }

      .window-name {
        font-family: monospace;
        font-size: 10px;
        color: #9b9b95;
      }

      .window-content {
        min-height: 350px;
        padding: 45px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .window-label {
        font-family: monospace;
        font-size: 12px;
        color: var(--muted);
      }

      .window-title {
        font-size: 43px;
        line-height: 1;
        letter-spacing: -0.05em;
        margin: 0;
      }

      .window-footer {
        display: flex;
        justify-content: space-between;
        gap: 20px;

        font-family: monospace;
        font-size: 11px;
        color: var(--muted);
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--mac-green);
      }

      /* -------------------------
         COMMON SECTION
      -------------------------- */

      section {
        padding: 110px 0;
        border-top: 1px solid var(--line);
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 55px;
      }

      h2 {
        font-size: 42px;
        margin: 0;
        letter-spacing: -0.045em;
      }

      .section-number {
        font-family: monospace;
        color: var(--muted);
        font-size: 12px;
      }

      /* -------------------------
         PROJECT WINDOWS
      -------------------------- */

      .project-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 22px;
      }

      .project {
        min-height: 360px;
        background: #fbfbf8;
        border: 1px solid #deddd6;
        border-radius: 15px;
        overflow: hidden;
        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease;
      }

      .project:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 35px rgba(0, 0, 0, 0.07);
      }

      .project.coming-soon {
        border-style: dashed;
        background:
          linear-gradient(
            135deg,
            rgba(255,255,255,0.35),
            rgba(255,255,255,0)
          ),
          #efeee8;
      }

      .project.coming-soon:hover {
        transform: translateY(-4px) rotate(0.5deg);
      }

      .project-bar {
        height: 39px;
        border-bottom: 1px solid #e5e4de;
        display: flex;
        align-items: center;
        padding: 0 13px;
      }

      .project-dots {
        display: flex;
        gap: 5px;
      }

      .project-dots span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
      }

      .project-dots span:nth-child(1) {
        background: var(--mac-red);
      }

      .project-dots span:nth-child(2) {
        background: var(--mac-yellow);
      }

      .project-dots span:nth-child(3) {
        background: var(--mac-green);
      }

      .project-body {
        height: calc(100% - 39px);
        padding: 26px;
        display: flex;
        flex-direction: column;
      }

      .project-icon {
        font-size: 30px;
        margin-bottom: auto;
      }

      .coming-soon .project-icon {
        font-family: monospace;
        color: #aaa9a2;
        letter-spacing: 0.1em;
      }

      .project-year {
        font-family: monospace;
        font-size: 11px;
        color: var(--muted);
      }

      .project h3 {
        font-size: 25px;
        margin: 12px 0;
        letter-spacing: -0.04em;
      }

      .project p {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
        margin: 0 0 20px;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
      }

      .tag {
        font-family: monospace;
        font-size: 10px;
        border: 1px solid #d8d7d0;
        padding: 5px 8px;
        border-radius: 100px;
      }

      /* -------------------------
         POST-IT NOTES
      -------------------------- */

      .notes-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 35px;
        padding: 30px 10px 40px;
      }
      .note-link {
        display: block;
        color: inherit;
        text-decoration: none;
      }
      .note {
        position: relative;

        aspect-ratio: 1 / 0.82;
        padding: 32px;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        box-shadow:
          0 15px 25px rgba(0, 0, 0, 0.08),
          0 2px 5px rgba(0, 0, 0, 0.04);

        transition: 0.25s ease;
        cursor: pointer;
      }

      /* 포스트잇 위 작은 테이프 */
      .note::before {
        content: "";

        position: absolute;
        top: -13px;
        left: 50%;

        width: 76px;
        height: 27px;

        background: rgba(255, 255, 255, 0.46);
        border: 1px solid rgba(255, 255, 255, 0.3);

        transform: translateX(-50%) rotate(-2deg);

        box-shadow: 0 2px 5px rgba(0,0,0,0.03);
      }

      .note:nth-child(2)::before {
        transform: translateX(-50%) rotate(2deg);
      }

      .note:hover {
        transform: rotate(0deg) translateY(-8px) !important;
        box-shadow:
          0 22px 35px rgba(0, 0, 0, 0.1),
          0 3px 8px rgba(0, 0, 0, 0.04);
      }

      .note.green {
        background: var(--green);
      }

      .note.blue {
        background: var(--blue);
      }

      .note.purple {
        background: var(--purple);
      }

      .note-category {
        font-family: monospace;
        font-size: 11px;
      }

      .note h3 {
        font-size: clamp(22px, 2vw, 32px);
        letter-spacing: -0.045em;
        line-height: 1.08;
        margin: 0;
      }

      .note-date {
        font-family: monospace;
        font-size: 10px;
        opacity: 0.6;
      }

      /* -------------------------
         ABOUT
      -------------------------- */

      .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 100px;
      }

      .about-title {
        font-size: clamp(48px, 5vw, 68px);
        font-weight: 650;
        letter-spacing: -0.055em;
        line-height: 0.98;
      }

      .about-star {
        display: inline-block;
        margin-left: 5px;
        font-size: 0.7em;
        transform: rotate(10deg);
      }

      .about-copy {
        color: var(--muted);
        line-height: 1.8;
        font-size: 16px;
        max-width: 520px;
      }

      .about-copy strong {
        color: var(--text);
        font-weight: 600;
      }

      /* -------------------------
         FOOTER
      -------------------------- */

      footer {
        padding: 60px 0;
        border-top: 1px solid var(--line);

        display: flex;
        justify-content: space-between;

        font-family: monospace;
        font-size: 11px;
        color: var(--muted);
      }

      footer span:last-child {
        letter-spacing: 0.06em;
      }

      /* -------------------------
         MOBILE
      -------------------------- */

      @media (max-width: 850px) {
        .hero {
          grid-template-columns: 1fr;
          min-height: auto;
          padding: 80px 0;
        }

        .window {
          transform: none;
        }

        .notes-grid {
          grid-template-columns: 1fr;
        }

        .about-grid {
          grid-template-columns: 1fr;
          gap: 35px;
        }

        nav {
          gap: 16px;
        }

        section {
          padding: 80px 0;
        }
      }

      @media (max-width: 520px) {
        .page {
          width: min(100% - 30px, 1180px);
        }

        header {
          height: 75px;
        }

        nav {
          font-size: 12px;
          gap: 12px;
        }

        h1 {
          font-size: 58px;
        }

        .window-content {
          min-height: 310px;
          padding: 32px;
        }

        .window-title {
          font-size: 38px;
        }

        .section-head {
          align-items: center;
        }

        h2 {
          font-size: 35px;
        }
      }
    </style>
  </head>

  <body>
    <div class="page">

      <!-- NAV -->

      <header>
        <a class="logo" href="/">ROSA LEE</a>

        <nav>
          <a href="#work">Work</a>
          <a href="#notes">Notes</a>
          <a href="#about">About</a>
        </nav>
      </header>

      <main>

        <!-- HERO -->

        <div class="hero">

          <div>
            <div class="eyebrow">
              AI · COMPUTER VISION · SOFTWARE
            </div>

            <h1>
              I build<br />
              things that<br />
              can see.
            </h1>

            <p class="hero-copy">
              Engineer exploring computer vision, AI,
              robotics and interactive software.
              This is where I keep the things I build,
              test and learn.
            </p>
          </div>

          <!-- CURRENT PROJECT WINDOW -->

          <div class="window">

            <div class="window-bar">

              <div class="dots">
                <div class="dot"></div>
                <div class="dot"></div>
                <div class="dot"></div>
              </div>

              <div class="window-name">
                current-project
              </div>

              <div></div>

            </div>

            <div class="window-content">

              <div class="window-label">
                ~/rosa/current-project
              </div>

              <h2 class="window-title">
                Pose<br />
                Estimation<br />
                AR
              </h2>

              <div class="window-footer">

                <span>
                  Real-time interaction · 2026
                </span>

                <span class="status">
                  <span class="status-dot"></span>
                  in progress
                </span>

              </div>

            </div>

          </div>

        </div>

        <!-- PROJECTS -->

        <section id="work">

          <div class="section-head">
            <h2>Selected Work</h2>
            <span class="section-number">01 / WORK</span>
          </div>

          <div class="project-grid">

            {projects.map((project) => (

              <article
                class={`project ${project.comingSoon ? "coming-soon" : ""}`}
              >

                <div class="project-bar">

                  <div class="project-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>

                </div>

                <div class="project-body">

                  <div class="project-icon">
                    {project.emoji}
                  </div>

                  <div>

                    <div class="project-year">
                      {project.year}
                    </div>

                    <h3>
                      {project.title}
                    </h3>

                    <p>
                      {project.description}
                    </p>

                    <div class="tags">

                      {project.tags.map((tag) => (
                        <span class="tag">
                          {tag}
                        </span>
                      ))}

                    </div>

                  </div>

                </div>

              </article>

            ))}

          </div>

        </section>

        <!-- NOTES -->

        <section id="notes">

          <div class="section-head">
            <h2>Notes</h2>
            <span class="section-number">02 / BLOG</span>
          </div>

          <div class="notes-grid">

            {notes.map((note) => (

              <a
                href={`/notes/${note.id}/`}
                class="note-link"
              >

                <article
                  class={`note ${note.data.color}`}
                  style={`transform: rotate(${note.data.rotate});`}
                >

                  <div class="note-category">
                    {note.data.category}
                  </div>

                  <h3>
                    {note.data.title}
                  </h3>

                  <div class="note-date">
                    {note.data.pubDate
                      .toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                      })
                      .toUpperCase()}
                  </div>

                </article>

              </a>

            ))}

          </div>

        </section>

        <!-- ABOUT -->

        <section id="about">

          <div class="section-head">
            <h2>About</h2>
            <span class="section-number">03 / ME</span>
          </div>

          <div class="about-grid">

            <div class="about-title">
              I make<br />
              things I<br />
              like.<span class="about-star">✦</span>
            </div>

            <div class="about-copy">

              Hi, I'm Rosa.

              <br /><br />

              I like AI, computer vision, robots,
              and making random things just because
              they sound fun.

              <br /><br />

              <strong>
                I'm going to spend my life doing
                what I want to do. :)
              </strong>

              <br /><br />

              Seoul, KR

            </div>

          </div>

        </section>

      </main>

      <footer>
        <span>© 2026 ROSA LEE</span>
        <span>GITHUB · LINKEDIN</span>
      </footer>

    </div>
  </body>
</html>