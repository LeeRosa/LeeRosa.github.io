---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: {
        id: post.id,
      },
      props: {
        post,
      },
    }));
}

const { post } = Astro.props;

const { Content } = await render(post);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{post.data.title} — Rosa Lee</title>

    <meta
      name="description"
      content={post.data.description}
    />

    <style>
      :root {
        --bg: #f5f4ee;
        --text: #171714;
        --muted: #73736d;
        --line: #d9d8d1;

        font-family:
          Inter,
          ui-sans-serif,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        width: min(820px, calc(100% - 40px));
        margin: 0 auto;
      }

      header {
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        font-weight: 750;
        font-size: 16px;
      }

      .back {
        font-family: monospace;
        font-size: 12px;
        color: var(--muted);
      }

      .post-window {
        margin: 45px 0 110px;

        background: #fcfcfa;
        border: 1px solid #d5d4ce;
        border-radius: 18px;
        overflow: hidden;

        box-shadow:
          0 30px 60px rgba(0, 0, 0, 0.06),
          0 4px 15px rgba(0, 0, 0, 0.03);
      }

      .window-bar {
        height: 48px;

        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;

        padding: 0 18px;

        border-bottom: 1px solid #e6e5df;
      }

      .dots {
        display: flex;
        gap: 7px;
      }

      .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
      }

      .dot:nth-child(1) {
        background: #ff5f57;
      }

      .dot:nth-child(2) {
        background: #febc2e;
      }

      .dot:nth-child(3) {
        background: #28c840;
      }

      .window-name {
        font-family: monospace;
        font-size: 10px;
        color: #9b9b95;
      }

      article {
        padding: 65px 70px 80px;
      }

      .category {
        font-family: monospace;
        font-size: 11px;
        letter-spacing: 0.1em;
        color: var(--muted);
        margin-bottom: 20px;
      }

      h1 {
        font-size: clamp(42px, 7vw, 72px);
        line-height: 0.98;
        letter-spacing: -0.055em;

        margin: 0 0 24px;
      }

      .description {
        color: var(--muted);
        font-size: 17px;
        line-height: 1.7;
        margin-bottom: 20px;
      }

      .date {
        font-family: monospace;
        font-size: 11px;
        color: var(--muted);

        padding-bottom: 45px;
        margin-bottom: 45px;

        border-bottom: 1px solid var(--line);
      }

      .content {
        font-size: 16px;
        line-height: 1.85;
      }

      .content :global(h2) {
        font-size: 29px;
        letter-spacing: -0.035em;

        margin-top: 55px;
        margin-bottom: 18px;
      }

      .content :global(h3) {
        font-size: 21px;
        margin-top: 38px;
      }

      .content :global(p) {
        margin: 18px 0;
      }

      .content :global(ul),
      .content :global(ol) {
        padding-left: 25px;
      }

      .content :global(li) {
        margin: 8px 0;
      }

      .content :global(code) {
        font-family: monospace;
        font-size: 0.9em;

        background: #eae9e3;

        padding: 3px 6px;
        border-radius: 5px;
      }

      .content :global(pre) {
        background: #1e1e1c;
        color: #f6f6f2;

        padding: 22px;
        border-radius: 12px;

        overflow-x: auto;
      }

      .content :global(pre code) {
        background: none;
        padding: 0;
      }

      .content :global(img) {
        max-width: 100%;
        border-radius: 12px;
        margin: 25px 0;
      }

      @media (max-width: 650px) {
        article {
          padding: 45px 26px 60px;
        }
      }
    </style>
  </head>

  <body>

    <div class="page">

      <header>
        <a href="/" class="logo">
          ROSA LEE
        </a>

        <a href="/#notes" class="back">
          ← NOTES
        </a>
      </header>

      <div class="post-window">

        <div class="window-bar">

          <div class="dots">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
          </div>

          <span class="window-name">
            rosa-notes.md
          </span>

          <div></div>

        </div>

        <article>

          <div class="category">
            {post.data.category}
          </div>

          <h1>
            {post.data.title}
          </h1>

          <div class="description">
            {post.data.description}
          </div>

          <div class="date">
            {post.data.pubDate.toLocaleDateString(
              "en-US",
              {
                month: "long",
                day: "numeric",
                year: "numeric",
              }
            )}
          </div>

          <div class="content">
            <Content />
          </div>

        </article>

      </div>

    </div>

  </body>
</html>